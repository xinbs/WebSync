# 允许的源，多个源用逗号分隔
ALLOWED_ORIGINS=http://localhost:3000

# 数据库配置
SQLALCHEMY_DATABASE_URI=sqlite:///websync.db

# JWT 配置
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRES=86400  # 1天，单位秒

# 上传文件配置
UPLOAD_FOLDER=uploads
SYNC_FOLDER=sync
MAX_UPLOAD_SIZE=104857600

# 临时免登录链接配置（秒）
MAGIC_LINK_DEFAULT_TTL=120
MAGIC_LINK_MIN_TTL=60
MAGIC_LINK_MAX_TTL=600
MAGIC_LINK_RATE_LIMIT=10

# Google OAuth 配置由项目根目录下已忽略的本地 JSON 提供
